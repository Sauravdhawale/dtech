# Use the EXISTING MongoDB Atlas database. Do not create a new database.
# Copy this file to .env and fill values from the existing server environment.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<existing-cluster>/<existing-database>?retryWrites=true&w=majority
JWT_SECRET=<strong-existing-or-rotated-secret>
EMAIL_USER=<portal@arkentechsolutions.com>
EMAIL_PASS=<existing-zoho-smtp-app-password>
